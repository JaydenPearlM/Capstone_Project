const Transaction = require('../models/Transaction');
const { toCsv } = require('../utils/csv');


exports.csv = async (req, res, next) => {
  try {
    const{
      fields,
      from,
      to,
      q, 
      categoryId,
    } = req.query;


    // Mongo filter incrementally
    const filter = {};

    if(from || to) {
      filter.date = {};
      if (fromm) filter.date.$gte = new Date(from);
      if (to) filter.date.$lte = new Date(to);
    }
    if (q) {
      filter.description = { $regex: q, $options: 'i' };
    }
    if (categoryId) {
      filter.categoryId = categoryId;
    }

    const data = await Transaction.find(filter).lean();
    
    //choose columns (defaults if not provided)

    const selected = (fields ? fields.split(',') : [
      'date','type','amount','description','categoryId'
    ]).map(s => s.trim()).filter(Boolean);

    //Map selected keys => header and select
    const headers = selected.map(key => ({
      label: key,
      select: (row) => {
        if (key == 'date') {
          return row.date ? new Date(row.date).toISOString().slice(0,10) : '';
        }
        return row[key];
      }
    }));
    
    const csv = toCsv(data, headers);

    res.setHeader('Content-Type', 'text/csv');
    res.setHeader('Content-Disposition', 'attachment; filename="transactions.csv');
    res.send(csv);
  } catch (err) {
    next(err);

    }
  };


  